# Contact email sent to Ensembl REST in the User-Agent header.
# Ensembl asks for this so they can reach you about abusive usage patterns.
SARNA_CONTACT_EMAIL=you@example.org

# Root for cached external data (Ensembl responses, bigWig slices).
# Keep on the Linux filesystem, NOT /mnt/c, for file-watching performance.
SARNA_CACHE_DIR=.cache

# Set to 1 to bypass all external lookups. Promoter-sequence design still works.
SARNA_OFFLINE=0
