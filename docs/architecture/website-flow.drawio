          <mxGeometry as="geometry" relative="1">
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="input" value="Choose input&#10;Human gene symbol or Ensembl gene ID&#10;or your promoter DNA / one FASTA" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#bdd7cc;fontColor=#183932;fontSize=14;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="160" width="340" height="120" />
        </mxCell>
        <mxCell id="lookup" value="Confirm the gene&#10;Ensembl GRCh38 · cached or online&#10;Gene contig, strand and transcripts" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#bdd7cc;fontColor=#183932;fontSize=14;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="460" y="160" width="340" height="120" />
        </mxCell>
        <mxCell id="overview" value="Whole-gene reference overview&#10;Exact shared TSSs retain transcript IDs&#10;Literature anchors keep source / caveats" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#bdd7cc;fontColor=#183932;fontSize=14;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="860" y="160" width="340" height="120" />
        </mxCell>
        <mxCell id="settings" value="Explain and adjust supported criteria&#10;Wang defaults · alternatives · citations&#10;Gate / preference / off · equal points" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#bdd7cc;fontColor=#183932;fontSize=14;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="370" width="340" height="120" />
        </mxCell>
        <mxCell id="references" value="Select one or several references&#10;Shared or pinned criteria per reference&#10;Own upstream / downstream retrieval span" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#bdd7cc;fontColor=#183932;fontSize=14;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="460" y="370" width="340" height="120" />
        </mxCell>
        <mxCell id="custom" value="Add your genomic reference&#10;GRCh38 +1 base entered 1-based&#10;Source, name and uncertainty recorded&#10;Researcher-supplied / inferred" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#bdd7cc;fontColor=#183932;fontSize=14;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="860" y="370" width="340" height="120" />
        </mxCell>
        <mxCell id="engine" value="Run Python separately per reference&#10;Generate, evaluate, gate and rank&#10;Named guide models · explained ratings&#10;One ranked context per reference" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#bdd7cc;fontColor=#183932;fontSize=14;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="460" y="580" width="340" height="120" />
        </mxCell>
        <mxCell id="context" value="Optional evidence context&#10;Regulatory build · motif predictions&#10;AF22 local tracks · missing data explicit&#10;No expression / activity inference" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#bdd7cc;fontColor=#183932;fontSize=14;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="860" y="580" width="340" height="120" />
        </mxCell>
        <mxCell id="edit" value="Edit and rerun&#10;Inspect reference and configuration first&#10;Same-reference admission / rank diff&#10;Earlier records remain saved" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#bdd7cc;fontColor=#183932;fontSize=14;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="790" width="340" height="120" />
        </mxCell>
        <mxCell id="comparison" value="Inspect the promoter comparison&#10;Progress / failures per reference&#10;Open each map, RNA cores and verdicts&#10;Separate ranks · no pooled best score" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#bdd7cc;fontColor=#183932;fontSize=14;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="460" y="790" width="340" height="120" />
        </mxCell>
        <mxCell id="store" value="Save / reopen locally&#10;SQLite group links complete child runs&#10;Reopen without recomputing&#10;Successes survive another child failure" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#bdd7cc;fontColor=#183932;fontSize=14;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="860" y="790" width="340" height="120" />
        </mxCell>
        <mxCell id="export" value="Export a frozen research record&#10;Group offline HTML and full JSON&#10;Individual core CSV / HTML / JSON&#10;Core CSV is not order-ready" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#bdd7cc;fontColor=#183932;fontSize=14;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="860" y="1000" width="340" height="120" />
        </mxCell>
        <mxCell id="interpretation" value="Annotated start sites and researcher references do not establish promoter activity. Ratings count criteria, not activation probability." style="text;html=0;align=left;fontSize=13;fontColor=#617974;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1020" width="720" height="70" />
        </mxCell>
      </root>
    </mxGraphModel>
